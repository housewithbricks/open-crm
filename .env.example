# Required: password for the web UI.
ADMIN_PASSWORD=change-me

# Optional: signs login sessions. Generated and stored in the database if empty.
SESSION_SECRET=

# Optional: public base URL, used to show the right MCP URL in the UI (e.g. https://crm.example.com).
PUBLIC_URL=

# Optional: password for the bundled Postgres (docker compose only). Set it before the first start.
POSTGRES_PASSWORD=opencrm

# Optional: host port for the app.
PORT=8080

# Optional: your domain, for `docker compose --profile https up -d` (Caddy + automatic HTTPS).
DOMAIN=

# --- Using your own Postgres instead of the bundled one ---
# DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require
# DATABASE_SSL=require   # only if your URL has no sslmode but the server needs TLS (e.g. Heroku)
